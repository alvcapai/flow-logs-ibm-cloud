###############################################################################
# schematics.tfvars  (rename to terraform.tfvars for local runs)
#
# In Schematics: set these as workspace variables in the UI or via CLI.
# Locally: copy to terraform.tfvars — never commit that file.
#
# Note: ibmcloud_api_key is NOT a Terraform variable in this module.
#       Set it as the IBMCLOUD_API_KEY environment variable, or in Schematics
#       as a secure env var — the IBM provider picks it up automatically.
###############################################################################

# Regions to scan. A Flow Log Collector is created for EVERY VPC found in each.
# Supported: br-sao, us-south, us-east, ca-tor, eu-de, eu-gb, au-syd, jp-tok, jp-osa
regions = ["br-sao", "us-south"]

# Resource group that will own all resources.
resource_group_id = "REPLACE_WITH_RESOURCE_GROUP_ID"

# -- COS ---------------------------------------------------------------------

# Set to false and provide existing_cos_instance_id if you already have a COS instance.
create_cos_instance      = true
cos_instance_name        = "cos-vpc-flow-logs-central"
# existing_cos_instance_id = "crn:v1:bluemix:public:cloud-object-storage:global::a/..."

# Prefix for bucket names — each bucket is named <prefix>-<region>.
# Must be globally unique in IBM Cloud COS.
cos_bucket_name_prefix = "enterprise-vpc-flowlogs"
